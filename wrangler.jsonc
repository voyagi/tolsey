{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tolsey",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp", "/mcp/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tolsey",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_HOSTNAMES": "tolsey.taranity.com"
  },
  "routes": [{ "pattern": "tolsey.taranity.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  }
}
