{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "entry": [
    // Gate harnesses and their mutant harnesses are run directly with node, never imported.
    "scripts/*.mjs",
    // The probe Worker is named only in intl-probe.wrangler.jsonc, which the Intl parity e2e test starts.
    "src/test-support/intl-probe.worker.ts",
    // Loaded by privacy.html, the second Vite input, which knip's Vite plugin does not read from the client
    // environment's build options.
    "src/ui/privacy-page.ts"
  ],
  // Reference mockups are loaded by HTML pages, which knip does not follow.
  "ignoreFiles": ["design/mockups/**"],
  "ignoreDependencies": [
    // Not imported: kept for the launch page's structured data, which this version does not build.
    "schema-dts",
    // Not imported: kept for the MCP Apps cards, which this version does not build, and pinned in
    // lockstep with server and client.
    "@modelcontextprotocol/ext-apps",
    // knip reads "testRunner": "command" as a package, but the command runner ships inside
    // @stryker-mutator/core.
    "@stryker-mutator/command-runner",
    // Read by path in scripts/a11y-live.mjs for injection into the page under test, never imported.
    "axe-core"
  ],
  // The browser CLI the layout check drives is installed on the machine, never in package.json:
  // wall-shots.mjs exits 2 when it is missing.
  "ignoreBinaries": ["dev-browser"]
}
